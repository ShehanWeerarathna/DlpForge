<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DlpForge.App.Views.ScheduleWindow"
        Title="Schedule download"
        Icon="/Assets/dlpforge.ico"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">
  <StackPanel Margin="18" Spacing="12">
    <TextBlock Classes="h2" Text="Start this download at" />
    <TextBlock x:Name="ItemTitle" Classes="subtle" TextTrimming="CharacterEllipsis" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <DatePicker x:Name="DateBox" />
      <TimePicker x:Name="TimeBox" MinuteIncrement="5" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" IsVisible="False" />
    <TextBlock Classes="subtle" TextWrapping="Wrap"
               Text="DlpForge must be running at that time. Turn on &quot;Keep running in the tray&quot; in Settings to close the window without stopping it." />
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6,0,0">
      <Button x:Name="StartNowButton" Content="Start now" Click="OnStartNow" ToolTip.Tip="Clears the start time and downloads as soon as there is room" />
      <Button Grid.Column="2" Content="Cancel" Click="OnCancel" Margin="0,0,8,0" IsCancel="True" />
      <Button x:Name="ScheduleButton" Grid.Column="3" Classes="accent" Content="Schedule" Click="OnSchedule" IsDefault="True" />
    </Grid>
  </StackPanel>
</Window>

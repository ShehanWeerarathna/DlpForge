<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DlpForge.App.Views.LogWindow"
        Title="Download log"
        Icon="/Assets/dlpforge.ico"
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <TextBlock x:Name="Heading" Classes="h2" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
    <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Copy all" Click="OnCopy" />
      <Button Content="Open log file" Click="OnOpenFile" />
      <Button Content="Close" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>

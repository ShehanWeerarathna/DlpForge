<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build: one self-contained DlpForge.exe that runs without .NET installed.
  dotnet publish src/DlpForge.App -c Release -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- SkiaSharp and HarfBuzzSharp ship debug symbols beside their native DLLs; leave them out. -->
  <Target Name="DropPackageSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
